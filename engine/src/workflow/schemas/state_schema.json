{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "leviathan-current-stage-v1",
  "title": "Leviathan Current Stage State",
  "description": "JSON Schema for validating leviathan-current-stage.json and leviathan-active-phase.json",
  "type": "object",
  "required": ["phase", "stage", "stage_detail", "escalation_level", "updated_at"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "description": "Current phase identifier, e.g. S13"
    },
    "stage": {
      "type": "string",
      "enum": ["A", "B", "C", "pending"],
      "description": "Current active stage within the phase"
    },
    "stage_detail": {
      "type": "object",
      "required": ["A", "B", "C"],
      "properties": {
        "A": {
          "$ref": "#/definitions/stageA"
        },
        "B": {
          "$ref": "#/definitions/stageB"
        },
        "C": {
          "$ref": "#/definitions/stageC"
        }
      },
      "additionalProperties": false
    },
    "escalation_level": {
      "type": "string",
      "pattern": "^L[0-5]$",
      "description": "Escalation level, L0 through L5"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "updated_by": {
      "type": "string",
      "description": "Agent or user who last updated this state"
    }
  },
  "definitions": {
    "stageStatus": {
      "type": ["string", "null"],
      "enum": ["pending", "in_progress", "completed", "failed", null]
    },
    "stageA": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/definitions/stageStatus" },
        "started_at": { "type": ["string", "null"] },
        "completed_at": { "type": ["string", "null"] },
        "entry_gate": { "type": ["string", "boolean", "null"] },
        "plan_file": { "type": ["string", "null"] },
        "quant_gate": { "type": ["string", "boolean", "null"] }
      },
      "additionalProperties": true
    },
    "stageB": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/definitions/stageStatus" },
        "started_at": { "type": ["string", "null"] },
        "completed_at": { "type": ["string", "null"] },
        "phase1_impl": { "type": ["string", "boolean", "null"] },
        "pytest_pass": { "type": ["boolean", "null"] },
        "phase2_shadow": { "type": ["string", "boolean", "null"] },
        "shadow_duration_min": { "type": ["number", "null"] },
        "shadow_pnl": { "type": ["number", "null"] },
        "shadow_wr": { "type": ["number", "null"] },
        "shadow_crash": { "type": ["integer", "null"] }
      },
      "additionalProperties": true
    },
    "stageC": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/definitions/stageStatus" },
        "started_at": { "type": ["string", "null"] },
        "completed_at": { "type": ["string", "null"] },
        "code_review": { "type": ["string", "boolean", "null"] },
        "security_review": { "type": ["string", "boolean", "null"] },
        "phase_review": { "type": ["string", "boolean", "null"] },
        "go_no_go": { "type": ["string", "boolean", "null"] },
        "ssot_updated": { "type": ["boolean", "null"] },
        "git_pushed": { "type": ["boolean", "null"] },
        "telegram_notified": { "type": ["boolean", "null"] },
        "boss_approved": { "type": ["boolean", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
