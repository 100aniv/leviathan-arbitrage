# =============================================================================
# LEVIATHAN Global Arbitrage Engine — Environment Variables
# Copy to .env and fill in your values. Never commit .env.
# =============================================================================

# --- Infrastructure ---
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://leviathan:leviathan@localhost:5432/leviathan

# --- Engine Settings ---
ENGINE_ENV=development          # development | staging | production
ENGINE_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
ENGINE_API_PORT=8000
ENGINE_WS_PORT=8001
ENGINE_WORKERS=4

# --- Risk Parameters ---
MAX_POSITION_USD=1000           # Maximum position size in USD per trade
MAX_DAILY_LOSS_USD=500          # Maximum daily loss before kill switch triggers
MAX_NET_EXPOSURE_PER_ASSET=5000 # Maximum net exposure per base asset (USD)
MIN_EDGE_BPS=5                  # Minimum net profit edge in basis points
MAX_ROLLBACK_THRESHOLD=0.02     # Maximum rollback cost as fraction of position (2%)
KILL_SWITCH_ENABLED=true

# --- Binance ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true            # Use testnet in development

# --- OKX ---
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_TESTNET=true

# --- Bybit ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# --- Kraken ---
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Coinbase ---
COINBASE_API_KEY=
COINBASE_API_SECRET=

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leviathan
DB_USER=leviathan
DB_PASSWORD=leviathan
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=                 # Leave empty for no auth
REDIS_MAX_CONNECTIONS=50

# --- Prometheus ---
PROMETHEUS_PORT=8000            # Metrics served on /metrics at this port
PROMETHEUS_PUSH_GATEWAY=        # Optional push gateway URL

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=leviathan

# --- Alerting ---
ALERT_WEBHOOK_URL=              # Slack/Discord webhook for critical alerts
ALERT_EMAIL=                    # Email for critical alerts

# --- Slippage Model ---
SLIPPAGE_MODEL=cex_orderbook    # cex_orderbook | cex_impact
SLIPPAGE_K_DEFAULT=1.0          # Impact coefficient (overestimate for safety)
SLIPPAGE_CONSERVATIVE_MULTIPLIER=1.5

# --- Execution ---
LEG_TIMEOUT_MS=1000             # Timeout for each leg fill confirmation
ROLLBACK_TIMEOUT_MS=2000        # Timeout for rollback market order
RECONCILIATION_INTERVAL_S=5    # Post-trade reconciliation delay
RECOVERY_RECONCILIATION_INTERVAL_S=60  # Redis recovery reconciliation loop

# --- Phase Gates ---
PHASE=alpha                     # alpha | beta | production
ALPHA_CAPITAL_PER_EXCHANGE=70   # USD per exchange in alpha
BETA_CAPITAL_PER_EXCHANGE=750   # USD per exchange in beta
