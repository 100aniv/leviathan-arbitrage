# =============================================================================
# LEVIATHAN — .gitignore
# =============================================================================

# --- Secrets & Environment ---
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
*.pfx
secrets/
credentials.json
service-account*.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# lib/ 제거 — dashboard/src/lib/ 까지 매칭되는 문제 있음. .venv/으로 이미 커버됨
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.virtualenv/

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
*.py,cover
nosetests.xml
test-results/

# --- Type Checking ---
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# --- Linting ---
.ruff_cache/

# --- Node / Next.js ---
node_modules/
.npm
.next/
out/
.nuxt/
dist/
.cache/
*.tsbuildinfo
.eslintcache
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# --- Docker ---
.docker/

# --- Database ---
*.db
*.sqlite3
*.sqlite
pgdata/
postgres-data/

# --- Logs ---
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDE & Editor ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V3
.Trashes
ehthumbs.db
Thumbs.db

# --- Build Artifacts ---
*.o
*.a
*.lib
*.dll
*.dylib
*.wasm

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Prometheus / Grafana data ---
prometheus_data/
grafana_data/

# --- Redis dump ---
dump.rdb

# --- Alembic ---
# Keep versions but ignore compiled
engine/src/infra/db/versions/__pycache__/

# --- OMC & Claude local state ---
# .omc/, .claude/ 제거 — CLAUDE.md, leviathan.md, prd.json, handoffs 등 소스코드 추적 필요
# 민감한 로컬 상태 파일만 선택적 제외:
.omc/state/
.omc/artifacts/

# --- Nginx TLS certs (generated locally, never committed) ---
infra/nginx/certs/

# --- Reports (generated by backtest/tuning runs) ---
**/reports/

# --- Temporary ---
tmp/
temp/
.tmp/
