{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [{ "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "iconColor": "rgba(0,211,255,1)", "name": "Annotations & Alerts", "type": "dashboard" }] },
  "description": "LEVIATHAN S20 ML Performance: data quality, stale events, execution latency",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "tags": ["leviathan", "s20"],
  "title": "S20 ML Performance",
  "uid": "s20-ml-performance",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-leviathan" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "green", "value": 0.9 }] },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true },
      "title": "Data Quality Score",
      "type": "gauge",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus-leviathan" }, "expr": "leviathan_data_quality_score", "legendFormat": "Quality" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-leviathan" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] }, "unit": "short" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Stale Data Events",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus-leviathan" }, "expr": "increase(leviathan_stale_data_events_total[5m])", "legendFormat": "Stale Events" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-leviathan" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.05 }, { "color": "red", "value": 0.1 }] }, "unit": "s" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Execution Latency (last)",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus-leviathan" }, "expr": "leviathan_execution_latency_seconds", "legendFormat": "Latency" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-leviathan" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineInterpolation": "linear", "showPoints": "never" }, "unit": "s" } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "Execution Latency Over Time",
      "type": "timeseries",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus-leviathan" }, "expr": "leviathan_execution_latency_seconds", "legendFormat": "Execution Latency" }]
    }
  ],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "refresh": "30s"
}
