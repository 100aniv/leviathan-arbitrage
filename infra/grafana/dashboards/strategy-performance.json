{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "LEVIATHAN — Per-Strategy Performance Metrics",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "PnL by Strategy",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-leviathan" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "currencyUSD"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "min", "max", "mean"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "PnL by Strategy (Time Series)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "engine_strategy_pnl_usd",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Win Rate & Sharpe",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-leviathan" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.45 },
              { "color": "green", "value": 0.55 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 10 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "Win Rate per Strategy",
      "type": "gauge",
      "targets": [
        {
          "expr": "engine_strategy_win_rate",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-leviathan" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 1.0 }
            ]
          },
          "unit": "short",
          "decimals": 2
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 10 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "title": "Sharpe Ratio Estimate",
      "type": "stat",
      "targets": [
        {
          "expr": "engine_strategy_sharpe_ratio",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "Trade Duration & Volume",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-leviathan" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "s",
          "decimals": 1
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 17 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "title": "Avg Trade Duration",
      "type": "stat",
      "targets": [
        {
          "expr": "engine_strategy_avg_trade_duration_seconds",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-leviathan" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "currencyUSD"
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 17 },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Trade Volume by Strategy",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(engine_strategy_trade_volume_usd[5m]) * 300",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "Strategy State Timeline",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-leviathan" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "fillOpacity": 70, "lineWidth": 0, "spanNulls": false },
          "mappings": [
            {
              "options": {
                "0": { "color": "green", "index": 0, "text": "ACTIVE" },
                "1": { "color": "yellow", "index": 1, "text": "PAUSED" },
                "2": { "color": "red", "index": 2, "text": "STOPPED" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 24 },
      "id": 6,
      "options": {
        "alignValue": "left",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "auto",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "title": "Strategy State Timeline (active / paused / stopped)",
      "type": "state-timeline",
      "targets": [
        {
          "expr": "engine_strategy_state",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "tags": ["leviathan", "strategy", "performance"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "LEVIATHAN Strategy Performance",
  "uid": "leviathan-strategy-performance",
  "version": 1
}
